# Template only. The binary does NOT read .env automatically.
# scripts/run.ps1 imports literal KEY=value lines; Compose reads .env for interpolation.
# Compose timezone; choose the deployment's local IANA zone explicitly.
TZ=Asia/Shanghai
# Compose host binding: 127.0.0.1 for reverse proxy; 0.0.0.0 for direct IP access.
COMIC_BIND_IP=127.0.0.1
GO_SERVICE_ADDR=127.0.0.1:5210
GO_SERVICE_DATA_ROOT=./data
GO_SERVICE_PUBLIC_DIR=../web/public
GO_SERVICE_SECURE_COOKIES=false
GO_SERVICE_MAX_BODY_BYTES=16777216
# Empty both selects single-user JSON mode; PG takes precedence when set.
GO_SERVICE_DATABASE_URL=
DATABASE_URL=
# Compose requires a unique PG password AND matching URI-encoded URL.
POSTGRES_PASSWORD=
# PG example shape only: postgres://comic:URI_ENCODED_PASSWORD@postgres:5432/comic?sslmode=disable
# Explicit one-shot bootstrap only; choose username and >=12-character password.
GO_SERVICE_ADMIN_USERNAME=
GO_SERVICE_ADMIN_PASSWORD=
# JSON-mode generation is for an explicitly bootstrapped admin only.
COMIC_TEXT_URL=
COMIC_TEXT_KEY=
COMIC_TEXT_MODEL=
COMIC_IMAGE_URL=
COMIC_IMAGE_KEY=
COMIC_IMAGE_MODEL=
